# EXAM SAFE PASS+ DEMO — environment variable NAMES only. Never put real values in this file.
# Set the real values as Codespaces Secrets (GitHub > Settings > Codespaces > Secrets) or in an untracked .env.
# Generate values with:  python3 tools/generate_secrets.py

# Required: administrator account (the server refuses to start without admin secrets).
EXAM_SAFE_ADMIN_USERNAME=            # optional login name (default: admin-demo)
EXAM_SAFE_ADMIN_PASSWORD_HASH=       # scrypt hash from tools/generate_secrets.py (never a plaintext password)
EXAM_SAFE_ADMIN_KEY=                 # API key, at least 16 random characters

# Optional roles; a role without secrets is disabled.
EXAM_SAFE_PROCTOR_USERNAME=
EXAM_SAFE_PROCTOR_PASSWORD_HASH=
EXAM_SAFE_PROCTOR_KEY=
EXAM_SAFE_SUPERVISOR_USERNAME=
EXAM_SAFE_SUPERVISOR_PASSWORD_HASH=
EXAM_SAFE_SUPERVISOR_KEY=
EXAM_SAFE_CANDIDATE_USERNAME=
EXAM_SAFE_CANDIDATE_PASSWORD_HASH=
EXAM_SAFE_CANDIDATE_KEY=

# Origins allowed to send state-changing browser requests (comma separated, exact https://host[:port]).
# Codespaces' own forwarded URL is derived automatically from CODESPACE_NAME and the forwarding domain.
EXAM_SAFE_ALLOWED_ORIGINS=
# Set to 1 to always add the Secure cookie flag (HTTPS behind a proxy also sets it via X-Forwarded-Proto).
EXAM_SAFE_COOKIE_SECURE=
# Login rate limit: failures per window (defaults 5 / 300 seconds).
EXAM_SAFE_LOGIN_MAX_FAILURES=
EXAM_SAFE_LOGIN_WINDOW_SECONDS=

# --- Judge-only Render deployment (render.yaml sets everything except the password) ---
EXAM_SAFE_JUDGE_MODE=                # 1 = closed judge sandbox (virtual candidates only, admin/operational routes disabled)
EXAM_SAFE_JUDGE_PASSWORD=            # judge password, 12+ characters; enter it only in the Render dashboard (kept as a hash in memory)
EXAM_SAFE_JUDGE_PASSWORD_HASH=       # alternative to the above: scrypt hash from tools/generate_secrets.py
EXAM_SAFE_JUDGE_SESSION_SECONDS=     # judge session lifetime (default 7200, minimum 300)
EXAM_SAFE_JUDGE_GLOBAL_MAX_FAILURES= # all-client failed-login cap per window (default 40)
EXAM_SAFE_TRUST_PROXY=               # 1 = rate-limit by the last X-Forwarded-For hop (only behind a trusted proxy such as Render)
EXAM_SAFE_DB=                        # judge mode requires a path other than the dev DB (render.yaml uses /tmp)
EXAM_SAFE_PHOTO_DIR=                 # judge mode requires a path other than images/ or demo_photos/ (render.yaml uses /tmp)
# Render provides PORT and RENDER_EXTERNAL_URL automatically; the server binds 0.0.0.0:$PORT when PORT is set.

# --- ID·DEMO Android app link (DEMO only; never operational) ---
EXAM_SAFE_IDAPP_SECRET=              # 32+ random characters (e.g. python3 -c "import secrets;print(secrets.token_urlsafe(48))"); keys the stored digests of pairing codes/tokens. Unset = link disabled. Never put it in the app/APK.
